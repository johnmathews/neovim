# Tool versions the gate scripts enforce. Sourced by scripts/health-check and
# scripts/bootstrap-linux.
# The 0.12 cutover raises NVIM_MIN to 0.12.0 and sets TREE_SITTER_MIN to 0.26.1,
# because nvim-treesitter's main branch needs both.

# health-check fails below this Neovim version
NVIM_MIN=0.11.0
# the release machines are expected to run; health-check warns on any other version
NVIM_PIN=0.12.6
# tree-sitter CLI minimum; empty means the CLI is not required
TREE_SITTER_MIN=
# node minimum (Mason's node-based servers)
NODE_MIN=18.0.0

# --- scripts/bootstrap-linux -------------------------------------------------
# Linux releases older than this glibc are unsupported (Ubuntu 24.04 ships 2.39).
GLIBC_MIN=2.39
# Release assets it installs. Each sha256 is the digest GitHub publishes for the
# asset (`gh release view <tag> -R <repo> --json assets`). Bump version and both
# digests together.
NVIM_SHA256_X86_64=474430d53e6264f6d6dd18db42d6dc9df3a1b56ca9e88a325bbf860e1a811d87
NVIM_SHA256_AARCH64=8f1f64a0bdb97247034038c3823c6cbad5bdf9ecd5751b85494b71c3ee04c815
TREE_SITTER_PIN=0.27.1
TREE_SITTER_SHA256_X86_64=c7e686aec16ba17053c2e6fd87600ccb10cf8ba3d055756b17e756d538e11114
TREE_SITTER_SHA256_AARCH64=3c0d0113cae3fea36f2336c271cbdacbcdb349edb006319155652b9386803c55
STYLUA_PIN=2.3.1
STYLUA_SHA256_X86_64=f0cfea40b3d72223497fa1650061f866e0d19a93a871aae22d3849f1bc9c2722
STYLUA_SHA256_AARCH64=21908eec45ff9666d4ae72825b81faa7fc4119124ed656eb1d470cbf9ed41bc9
UV_PIN=0.12.24
UV_SHA256_X86_64=b4dfaef47d491a7296981f8374a4595f55dbf84e8937c8ecd2983574d8bb3da6
UV_SHA256_AARCH64=5231be65f496304623895dacdbf1de8504fec90303684bdf05805aa34414dd21
