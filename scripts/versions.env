# Tool versions the gate scripts enforce. Sourced by scripts/health-check.
# The 0.12 cutover raises NVIM_MIN to 0.12.0 and sets TREE_SITTER_MIN to 0.26.1,
# because nvim-treesitter's main branch needs both.

# health-check fails below this Neovim version
NVIM_MIN=0.11.0
# the release machines are expected to run; health-check warns on any other version
NVIM_PIN=0.11.6
# tree-sitter CLI minimum; empty means the CLI is not required
TREE_SITTER_MIN=
# node minimum (Mason's node-based servers)
NODE_MIN=18.0.0
